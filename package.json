{
  "name": "interdiesel",
  "version": "1.0.0",
  "description": "Gestion de stock et de ventes hors ligne pour Inter-Diesel (Bukavu)",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts server/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs --loader:.json=json",
    "start": "node dist/index.mjs",
    "demo": "node dist/cli.mjs demo",
    "init": "node dist/cli.mjs init",
    "backup": "node dist/cli.mjs backup",
    "restore": "node dist/cli.mjs restore",
    "password": "node dist/cli.mjs password",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "author": "Inter-Diesel",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.4",
    "barcode-detector": "^3.2.2",
    "better-sqlite3": "^13.0.3",
    "dexie": "^4.4.6",
    "fastify": "^5.12.5",
    "preact": "^10.29.8",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
